# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
# Postgres connection string (Supabase or self-hosted). Also where
# scripts/set_provider.py writes the DB-backed provider override (see
# SETUP.md §3.6) -- pointed at a local Postgres, that override is local only;
# it never reaches production unless this URL itself is the production one.
DATABASE_URL=

# --- Public Base URL ---
# Optional; auto-populated on Render as RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=

# --- GitHub App ---
# Numeric App ID: App settings -> General -> "App ID". See SETUP.md §1, which
# also explains why this is not the Client ID or the Installation ID.
GITHUB_APP_ID=
# Optional: the app auto-discovers this at boot when left empty.
GITHUB_APP_INSTALLATION_ID=
# Local development: path to the downloaded private-key PEM (kept out of git; see .gitignore).
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
# Render/hosted: base64-encoded private key (set in dashboard, never committed).
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=
# Target repository for pull requests (owner/repo format)
GITHUB_TARGET_REPO=

# --- LLM provider ---
# One of: gemini | groq | github_models
LLM_PROVIDER=gemini

# Each credential below can have numbered siblings -- BASE_1, BASE_2, ... --
# swappable at runtime with no redeploy via `scripts/set_provider.py`'s
# key-index override (see README "Swapping API keys without a redeploy").
# Uncomment and fill in only the slots you actually plan to use; an unfilled
# slot is simply never selected, and adding one later needs one redeploy to
# provision (or a manual push -- see the Open Items note on that gap).

# gemini (AI-Studio, free tier, no card required)
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# groq (free tier fallback / cross-vendor demo)
GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# groq's own model var — see note below on why this isn't shared with LLM_MODEL.
GROQ_MODEL=llama-3.3-70b-versatile

# github_models (rides your existing GitHub account, no separate signup) —
# needs a fine-grained PAT with the "Models: read" permission, created at
# github.com/settings/personal-access-tokens/new
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_TOKEN_1=
# GITHUB_MODELS_TOKEN_2=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Model alias for the gemini provider ONLY. Each other
# provider family (groq, github_models) has its own model var above — one
# shared LLM_MODEL stopped making sense once multiple unrelated provider
# families entered the picture — pinnable to a dated version for demo
# reproducibility.
LLM_MODEL=gemini-flash-latest

# --- Optional operator tooling (NOT used by the deployed service) ---
# Read only by scripts/deploy.py on your own machine. Never add these to
# render.yaml and never set them on the Render service. Leaving any of them
# empty simply skips the check it enables.
# Render API key (Account Settings -> API Keys): enables the render-service
# check and `--sync-env`.
RENDER_API_KEY=
# Render service name; must match `name:` in render.yaml.
RENDER_SERVICE_NAME=pr-review-engine
# UptimeRobot read-only API key: enables the uptime-pinger check.
UPTIMEROBOT_API_KEY=
