# Copy this file to .env and fill in real values. .env is gitignored.

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Path to the downloaded private-key PEM (kept out of git; see .gitignore).
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- LLM provider ---
# One of: vertex | gemini | groq
LLM_PROVIDER=gemini

# vertex (only needed if LLM_PROVIDER=vertex; requires GCP billing enabled)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# gemini (AI-Studio, free tier, no card required)
GEMINI_API_KEY=

# groq (free tier fallback / cross-vendor demo)
GROQ_API_KEY=

# Model alias (pinnable to a dated version for demo reproducibility)
LLM_MODEL=gemini-flash-latest
