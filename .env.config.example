# Operational config -- NO SECRETS. Copy to .env.config and edit freely.
# .env.config is gitignored (machine-specific choices), but unlike .env it
# holds nothing that authenticates anything, so it is safe for anyone -- and
# any agent -- to open and edit directly.
#
# Anything not listed in app/config.py's OPERATIONAL_KEYS belongs in .env
# instead. tests/test_config.py enforces that split by key NAME.

# --- LLM provider ---
# One of: gemini | groq | vertex
LLM_PROVIDER=gemini

# Model alias for the gemini provider (google-genai, AI Studio backend),
# pinnable to a dated version for demo reproducibility.
LLM_MODEL=gemini-flash-latest

# groq's own model var -- a different vendor and model family, so a single
# shared LLM_MODEL stopped making sense once groq entered the picture.
GROQ_MODEL=llama-3.3-70b-versatile

# vertex's own model var. gemini-flash-latest does NOT exist as a Vertex
# publisher model (404) -- gemini-2.5-flash is confirmed working. See SETUP.md
# section 2 for how to check your own project's Vertex catalog.
VERTEX_MODEL=gemini-2.5-flash

# Optional: derived from the service-account key's own project_id when unset.
GCP_PROJECT=
# Optional: which Vertex regional endpoint to call.
GCP_LOCATION=us-central1

# --- Target repository allowlist (owner/repo, comma-separated) ---
# Optional. Leave empty to track every repo the GitHub App installation
# covers instead of restricting to a specific subset.
GITHUB_TARGET_REPO=

# --- Public base URL ---
# Optional; auto-populated on Render as RENDER_EXTERNAL_URL. Set locally so a
# health check can reach the deployment without needing any credential.
PUBLIC_BASE_URL=

# --- Render service name; must match `name:` in render.yaml ---
RENDER_SERVICE_NAME=pr-review-engine

# --- Optional: proactive per-key daily usage cap ---
# Unset by default (cap off). When set, the dispatcher refuses to START a
# review once the ACTIVE (provider, key slot) has already used this much since
# the last reset, deferring the ticket to the next reset instead.
# KEY_USAGE_TOKEN_CAP wins outright when both are set -- the cost cap is then
# not consulted at all.
# These 3 keys are NEVER a Render env var -- they live only in the database.
# Edit here, then `uv run python -m scripts.deploy --sync-config-db` (or
# --sync-env, which does this too) to push it in, no redeploy required.
# KEY_USAGE_TOKEN_CAP=20000
# KEY_USAGE_COST_CAP_USD=0.50
# When the usage day rolls over, UTC. Any HH:MM or HH:MM:SS -- not
# whole-hours-only, so a demo can set a reset a couple of minutes out.
KEY_USAGE_RESET_TIME_UTC=04:00

# --- Optional: LLM request timeout ---
# Ceiling on a single LLM request, in seconds. The dispatcher is a single
# serial consumer of the whole queue -- a hung call with no timeout would
# stall every pending PR's review, not just one.
# LLM_REQUEST_TIMEOUT_SECONDS=45

# --- Optional: dispatcher tuning ---
# How long the dispatcher sleeps between polls when the queue is empty.
# DISPATCHER_IDLE_SLEEP_SECONDS=1
# Backoff fallback used when a rate-limited provider response carries no
# Retry-After header of its own.
# DEFAULT_RETRY_AFTER_SECONDS=60
# Starting backoff after a hard (non-rate-limit) failure, and the ceiling
# that backoff escalates up to across repeated failures.
# DISPATCHER_FAILURE_BASE_BACKOFF_SECONDS=2
# DISPATCHER_FAILURE_MAX_BACKOFF_SECONDS=300
# How many times a hard failure is retried before the ticket is given up on
# as terminally failed.
# DISPATCHER_MAX_FAILURE_ATTEMPTS=5
# How many times posting a "still waiting" schedule notice is retried before
# giving up on that notice (the review itself is unaffected).
# DISPATCHER_MAX_NOTICE_POST_ATTEMPTS=3
# Floor under any computed retry-after wait, so a near-zero or negative value
# from a misbehaving upstream can never turn into a tight retry loop.
# DISPATCHER_MIN_RETRY_AFTER_SECONDS=1
# Random jitter (0 to this many seconds) added to a computed backoff, to
# avoid multiple deferred tickets waking up in lockstep.
# DISPATCHER_BACKOFF_JITTER_SECONDS=0
# Re-review cooldown after a PR is updated: the base wait, the ceiling it
# escalates up to on repeated re-reviews, and the multiplier applied at each
# escalation step (must be >= 1.0, or repeated escalation would shrink the
# cooldown instead of lengthening it). Like the usage cap above, these 3 keys
# are NEVER a Render env var -- edit here, then
# `uv run python -m scripts.deploy --sync-config-db` to push it into the
# database, no redeploy required. See README's "Changing operational config".
# DISPATCHER_REREVIEW_COOLDOWN_SECONDS=300
# DISPATCHER_REREVIEW_COOLDOWN_MAX_SECONDS=3600
# DISPATCHER_REREVIEW_COOLDOWN_FACTOR=2.0
# How many due "still waiting" schedule notices are swept and posted per
# dispatcher pass (must be > 0, or the sweep would be silently disabled or
# unbounded).
# DISPATCHER_NOTICE_SWEEP_BATCH_SIZE=20
